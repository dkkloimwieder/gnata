*.wasm
.secret
.DS_Store
target/

# Large benchmark fixtures (>10MB, regenerate via python3 script in run_scaled.sh header)
bench/data_100k*.json

# Benchmark results (transient, per-run)
bench/results/
bench/results_json/
bench/result_*.json

# Profiling artifacts (regenerate with perf / cargo flamegraph)
perf.data*
bench/flamegraph*.svg

# Compiled Go bench binary (source: bench/go_bench.go)
bench/go_bench

# Wrapper scripts generated and deleted by bench/run_full.sh
bench/_go.sh
bench/_rs.sh

# Large generated fixtures (regenerate with: python3 bench/generate_fixtures.py --sizes 10k,100k)
bench/fixtures/logs/10k.json
bench/fixtures/logs/100k.json
bench/fixtures/strings/10k.json
bench/fixtures/strings/100k.json
bench/fixtures/datetime/10k.json
bench/fixtures/datetime/100k.json

# npm package build artifacts
npm/dist/
npm/node_modules/

# Bench JS dependencies
bench/node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
